# -------------------------
# DATABASE / CACHE
# -------------------------
MONGO_URI=''                  # MongoDB connection URI — required (@zanix/datamaster)
REDIS_URI=''                  # Redis connection URI — enables refresh-token rotation reuse
                               # detection (auth-jwt-and-sessions) and cross-replica OTP/rate-limit
                               # state; omit for a single-instance/dev setup (in-memory fallback)

# -------------------------
# JWT / SESSIONS (@zanix/auth)
# -------------------------
JWT_KEY=''                    # HMAC signing key for `user`-type session tokens
JWK_PRI=''                    # RSA private key (base64, PKCS#8) for `api`-type session tokens
JWK_PUB=''                    # RSA public key (base64, SPKI) — verifies `api`-type tokens
# JWK_ROTATION_CYCLE=''       # e.g. '30m' — only takes effect with multiple versioned keys (_V1, _V2, ...)

# -------------------------
# GOOGLE OAUTH2 (auth.app.ts's `googleOAuth2` resource — optional, both required together)
# -------------------------
GOOGLE_OAUTH2_CLIENT_ID=''
GOOGLE_OAUTH2_CLIENT_SECRET=''
GOOGLE_OAUTH2_REDIRECT_URI=''

# -------------------------
# GITHUB OAUTH2 (auth.app.ts's `githubOAuth2` resource — optional, both required together)
# -------------------------
GITHUB_OAUTH2_CLIENT_ID=''
GITHUB_OAUTH2_CLIENT_SECRET=''
GITHUB_OAUTH2_REDIRECT_URI=''

# -------------------------
# CAPTCHA (login/pwd-recovery guard — optional; set exactly one provider's secret key, or
# CAPTCHA_PROVIDER to disambiguate if more than one is set at once)
# -------------------------
# CAPTCHA_PROVIDER=''         # 'recaptcha' | 'hcaptcha' | 'turnstile'
RECAPTCHA_SECRET_KEY=''
# HCAPTCHA_SECRET_KEY=''
# TURNSTILE_SECRET_KEY=''

# -------------------------
# ANONYMOUS RATE LIMITS (auth-domain endpoints — see utils/constants.ts)
# -------------------------
FREE_RATELIMIT=3               # low-risk endpoints (login, OAuth2 start, refresh)
CRITIC_RATELIMIT=1              # sensitive endpoints (OTP/recovery dispatch)

# -------------------------
# SESSION TOKEN LIFETIMES (login only — see utils/constants.ts; both optional)
# -------------------------
# ACCESS_TOKEN_EXPIRATION=''    # e.g. '30m'/'1h', or a bare number of seconds — unset uses
                                 # @zanix/auth's own '1h' default. Capped at 1h by @zanix/auth
                                 # itself (a longer value throws at the next login).
# REFRESH_TOKEN_EXPIRATION=''   # e.g. '7d'/'1y', or a bare number of seconds — unset uses
                                 # @zanix/auth's own '1y' default. Must be at least 3x
                                 # ACCESS_TOKEN_EXPIRATION (@zanix/auth throws otherwise).

# -------------------------
# NOTIFICATIONS (@zanix/notifications — OTP/recovery/TOTP/welcome/password-changed dispatch)
# -------------------------
SMTP_HOST=''
SMTP_PORT=''
SMTP_USER=''
SMTP_PASSWORD=''
# SMS — set exactly one provider's vars, or SMS_PROVIDER to disambiguate
# TWILIO_ACCOUNT_SID='' / TWILIO_AUTH_TOKEN='' / TWILIO_FROM_NUMBER=''
# VONAGE_API_KEY='' / VONAGE_API_SECRET='' / VONAGE_FROM=''
# WhatsApp — set exactly one provider's vars, or WHATSAPP_PROVIDER to disambiguate
# META_PHONE_NUMBER_ID='' / META_ACCESS_TOKEN=''
# TWILIO_WHATSAPP_FROM=''  (reuses TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above)

# -------------------------
# NOTIFICATION TEMPLATES — database-backed, editable via this project's own /templates API and,
# once synced, a central console's Templates page (see notifications-template-storage-modes)
# -------------------------
TEMPLATES_BACKEND=local

# -------------------------
# DATA ENCRYPTION (@zanix/datamaster — protects password/oauthRefreshToken/totpSecret/phone)
# -------------------------
DATA_SECRET_KEY=''
DATA_AES_KEY=''

# -------------------------
# COOKIE CONSENT / TERMS (login/session UX — both optional)
# -------------------------
# COOKIE_CONSENT_ENABLED=false  # set to 'false' to turn off the project-wide cookie-consent modal
                                 # (space/middleware.ts's cookieConsentBypassGuard keeps session
                                 # cookies working anyway); any other value, or unset, keeps it on
# TERMS_AND_CONDITIONS_URL=''   # shows a "Terms and Conditions" link on the login page when set
