# -------------------------
# DATABASE / CACHE
# -------------------------
MONGO_URI=''                  # MongoDB connection URI — required (@zanix/datamaster)
REDIS_URI=''                  # Redis connection URI — enables refresh-token rotation reuse
                               # detection (@zanix/auth sessions) and cross-replica OTP/rate-limit
                               # state; omit for a single-instance/dev setup (in-memory fallback)

# -------------------------
# INSTANCE IDENTITY (utils/constants.ts — optional)
# -------------------------
# SERVICE_ID=''                 # This instance's own identity — used in RBAC permission codes,
                                 # the TOTP issuer, and user-facing email copy, so a self-hosted
                                 # instance never surfaces 'zanix-iam' to its own users. Letters
                                 # and hyphens only. Unset defaults to 'zanix-iam'.

# -------------------------
# DATABASE NAME (@zanix/datamaster — optional, needs a datamaster carrying MONGO_DB_NAME)
# -------------------------
# MONGO_DB_NAME=''              # Names the Mongo database this instance uses. Unset, it is derived
                                 # from this project's deno.json name ('zanix_iam'). Set a different
                                 # one to run a second instance (e.g. for staff accounts) that keeps
                                 # its own users, roles and sessions, on the same or another server.

# -------------------------
# ACCOUNT SELF-REGISTRATION (utils/constants.ts — optional)
# -------------------------
# SELF_REGISTRATION='true'      # Unset or anything but 'false': an unknown email may create its own
                                 # account through OTP or OAuth2 sign-in. 'false': every account must
                                 # be created beforehand by an administrator (POST /users/register) —
                                 # for a staff console or partner portal's own instance.

# -------------------------
# FIRST-ADMIN BOOTSTRAP (production-safe, opt-in — set BOTH on a genuinely fresh deployment only;
# POST /users/register is itself gated behind a permission nobody holds until this runs once)
# -------------------------
# FIRST_ADMIN_EMAIL=''          # Seeds one 'superadmin' account on boot when set together with
# FIRST_ADMIN_PASSWORD=''       # FIRST_ADMIN_PASSWORD. Runs once — safe to leave set afterward.

# -------------------------
# VISUAL THEME (space.app.ts's theme.resolve — optional)
# -------------------------
# IAM_THEME=''                  # JSON object of --space-* token overrides, e.g.
                                 # '{"--space-color-primary":"#16a34a"}'. Unset renders with
                                 # @zanix/space-ui's own defaults. Malformed JSON fails the first
                                 # request, never applies a value halfway.

# -------------------------
# MESSAGE CATALOG (base catalog: ui/sdk/messages — optional)
# -------------------------
# IAM_MESSAGES=''                # JSON object of catalog-key overrides, e.g.
                                 # '{"login/heading":"Welcome to Acme"}'. Merged on top of the base
                                 # catalog. Malformed JSON fails the first request, same as IAM_THEME.

# -------------------------
# POST-LOGIN DESTINATION (login/2FA/password-recovery success — optional)
# -------------------------
# POST_LOGIN_REDIRECT_URL=''    # Where a successful login/confirmation lands. Unset defaults to
                                 # '/' — this project ships no dashboard/account page of its own.
# TRUSTED_REDIRECT_ORIGINS=''   # Comma-separated allowlist of origins a caller's own ?redirect_to=
                                 # may point at ABSOLUTELY (e.g. 'https://app.example.com,
                                 # https://admin.example.com') — lets a consumer app on a DIFFERENT
                                 # origin send a visitor to this project's hosted login/2FA UI and
                                 # get them back on its own domain. Unset means no absolute URL is
                                 # ever trusted — redirect_to still works for same-origin relative
                                 # paths regardless.

# -------------------------
# JWT / SESSIONS (@zanix/auth)
# -------------------------
JWT_KEY=''                    # HMAC signing key for `user`-type session tokens
JWK_PRI=''                    # RSA private key (base64, PKCS#8) for `api`-type session tokens
JWK_PUB=''                    # RSA public key (base64, SPKI) — verifies `api`-type tokens
# JWK_ROTATION_CYCLE=''       # e.g. '30m' — only takes effect with multiple versioned keys (_V1, _V2, ...)

# -------------------------
# GOOGLE OAUTH2 (auth.app.ts's `googleOAuth2` resource — optional, both required together)
# -------------------------
GOOGLE_OAUTH2_CLIENT_ID=''
GOOGLE_OAUTH2_CLIENT_SECRET=''
GOOGLE_OAUTH2_REDIRECT_URI=''

# -------------------------
# GITHUB OAUTH2 (auth.app.ts's `githubOAuth2` resource — optional, both required together)
# -------------------------
GITHUB_OAUTH2_CLIENT_ID=''
GITHUB_OAUTH2_CLIENT_SECRET=''
GITHUB_OAUTH2_REDIRECT_URI=''

# -------------------------
# CAPTCHA (login/pwd-recovery guard — optional; set exactly one provider's secret key, or
# CAPTCHA_PROVIDER to disambiguate if more than one is set at once)
# -------------------------
# CAPTCHA_PROVIDER=''         # 'recaptcha' | 'hcaptcha' | 'turnstile'
RECAPTCHA_SECRET_KEY=''
# HCAPTCHA_SECRET_KEY=''
# TURNSTILE_SECRET_KEY=''

# -------------------------
# ANONYMOUS RATE LIMITS (auth-domain endpoints — see utils/constants.ts)
# -------------------------
FREE_RATELIMIT=3               # low-risk endpoints (password login, OTP/TOTP/OAuth2 callbacks)
CRITICAL_RATELIMIT=1              # sensitive endpoints (OTP/recovery dispatch, OAuth2 start, refresh)
# GET /login/methods/:email, on its own bucket. Defaults to 2: the two lookups a sign-in makes.
# LOGIN_METHODS_RATELIMIT=2

# -------------------------
# SESSION TOKEN LIFETIMES (login only — see utils/constants.ts; both optional)
# -------------------------
# ACCESS_TOKEN_EXPIRATION=''    # e.g. '30m'/'1h', or a bare number of seconds — unset uses
                                 # @zanix/auth's own '1h' default. Capped at 1h by @zanix/auth
                                 # itself (a longer value throws at the next login).
# REFRESH_TOKEN_EXPIRATION=''   # e.g. '7d'/'1y', or a bare number of seconds — unset uses
                                 # @zanix/auth's own '1y' default. Must be at least 3x
                                 # ACCESS_TOKEN_EXPIRATION (@zanix/auth throws otherwise).

# -------------------------
# NOTIFICATIONS (@zanix/notifications — OTP/recovery/TOTP/welcome/password-changed dispatch)
# -------------------------
SMTP_HOST=''
SMTP_PORT=''
SMTP_USER=''
SMTP_PASSWORD=''
# SMS — set exactly one provider's vars, or SMS_PROVIDER to disambiguate
# TWILIO_ACCOUNT_SID='' / TWILIO_AUTH_TOKEN='' / TWILIO_FROM_NUMBER=''
# VONAGE_API_KEY='' / VONAGE_API_SECRET='' / VONAGE_FROM=''
# WhatsApp — set exactly one provider's vars, or WHATSAPP_PROVIDER to disambiguate
# META_PHONE_NUMBER_ID='' / META_ACCESS_TOKEN=''
# TWILIO_WHATSAPP_FROM=''  (reuses TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above)

# -------------------------
# NOTIFICATION TEMPLATES — database-backed, editable via this project's own /templates API and,
# once synced, a central console's Templates page (@zanix/notifications template storage)
# -------------------------
TEMPLATES_BACKEND=local

# -------------------------
# DATA ENCRYPTION (@zanix/datamaster — protects password/oauthRefreshToken/totpSecret/phone)
# -------------------------
DATA_SECRET_KEY=''
DATA_AES_KEY=''

# -------------------------
# COOKIE CONSENT / TERMS (login/session UX — both optional)
# -------------------------
# COOKIE_CONSENT_ENABLED=false  # set to 'false' to turn off the project-wide cookie-consent modal
                                 # (space/middleware.ts's cookieConsentBypassGuard keeps session
                                 # cookies working anyway); any other value, or unset, keeps it on
# TERMS_AND_CONDITIONS_URL=''   # shows a "Terms and Conditions" link on the login page when set
# PRIVACY_NOTICE_URL=''         # shows a "Privacy Notice" link on the login page when set;
                                 # independent of TERMS_AND_CONDITIONS_URL

# -------------------------
# SELF-REGISTRATION DEFAULT ROLE (utils/constants.ts — optional)
# -------------------------
# DEFAULT_ROLE_ID=''            # roles.id auto-assigned to an account created through OTP or
                                 # OAuth2 self-registration. Unset: new accounts get no role and
                                 # therefore no permissions.

# -------------------------
# OAUTH2 PROVIDER CLIENTS (utils/oauth-provider.ts — optional)
# -------------------------
# OAUTH_PROVIDER_CLIENTS=''     # JSON array of {"clientId","clientSecret","redirectUris":[...]}
                                 # hosts allowed to use GET /oauth/authorize + POST /oauth/token.
                                 # Unset: /oauth/authorize rejects every request. Malformed JSON
                                 # fails loudly.
