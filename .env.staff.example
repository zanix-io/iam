# A second `iam` instance for STAFF surfaces (a moderation console, a partner portal): no open
# self-registration and its own database. Copy to `.env.staff` (gitignored) and fill in. Run it with
# only this file, never together with another instance's env file.

# Production mode: no development seeders (they create an account with a well-known password).
ENV='production'

# This instance's identity (RBAC codes, TOTP issuer, email copy). Letters and hyphens only.
SERVICE_ID='iam-staff'

# Its own database, so its accounts, roles and sessions never mix with the main instance's. Needs
# @zanix/datamaster >= 1.11.1. May live on the same MongoDB server or on another one (MONGO_URI).
MONGO_DB_NAME='iam_staff'
MONGO_URI=''

# Accounts are created beforehand by an administrator, never by signing in.
SELF_REGISTRATION='false'

# Another port than the main instance.
PORT=8001
PORT_SSR=20303

# Seeds the first superadmin on a fresh database. Use it to create staff (POST /users/register) and
# give them roles; then remove it or keep it, it only runs once.
FIRST_ADMIN_EMAIL=''
FIRST_ADMIN_PASSWORD=''

# The SAME signing keys as the main instance: the services that receive a staff member's token
# (the consumer apps' own backends) verify it with them.
JWT_KEY=''
JWK_PRI=''
JWK_PUB=''
DATA_AES_KEY=''
DATA_SECRET_KEY=''

# Delivery of one-time codes.
SMTP_HOST=''
SMTP_PORT=''
SMTP_USER=''
SMTP_PASSWORD=''
TEMPLATES_BACKEND='local'
